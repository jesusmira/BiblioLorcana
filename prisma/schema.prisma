generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  password         String
  role             Role       @default(USER)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  avatarUrl        String?
  bio              String?
  decks            Deck[]
  userCards        UserCard[]

  @@map("users")
}

model UserCard {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cardId    String   @map("card_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@map("user_cards")
}

model StarterDeck {
  id          String            @id
  name        String
  set         String
  inks        String[]
  description String
  profile     String
  cards       StarterDeckCard[]

  @@map("starter_decks")
}

model StarterDeckCard {
  id        String      @id @default(cuid())
  deckId    String      @map("deck_id")
  cardId    String      @map("card_id")
  name      String
  quantity  Int
  ink       String
  type      String
  cost      Int
  rarity    String
  subtypes  String?
  abilities String?
  imageUrl  String?
  deck      StarterDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("starter_deck_cards")
}

model Deck {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  name        String
  description String?
  format      String?
  strategy    String?
  tier        String?
  inkColors   String[]   @map("ink_colors")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  cards       DeckCard[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("decks")
}

model DeckCard {
  id       String @id @default(uuid())
  deckId   String @map("deck_id")
  cardId   String @map("card_id")
  name     String
  quantity Int    @default(1)
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@map("deck_cards")
}

enum Role {
  USER
  ADMIN
}
